# Copy to .env for local development. Never commit real keys.

# --- Remote MCP authentication ---
# Required by `python -m core.remote`. Inject the real value from Yandex Lockbox.
MARKETPLACE_MCP_BEARER_TOKEN=

# --- Remote multi-cabinet source ---
# JSON object injected by Yandex Lockbox. In remote mode credentials are immutable.
MARKETPLACE_MCP_CABINETS_JSON=

# --- Canonical Google Drive archive via Marketplaces Bridge v3 ---
# V3 is the only supported Marketplaces Drive transport.
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_PROTOCOL=v3
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_URL=
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_SECRET=
MARKETPLACE_MCP_ARCHIVE_DRIVE_ROOT_ID=

# Direct read-only Google Drive API backend.
# Keep 0 for the legacy Apps Script transport; set 1 to use the
# Service Account based DirectGoogleDriveArchiveStore.
MARKETPLACE_MCP_ARCHIVE_DIRECT_GOOGLE=0

# Path to a Service Account JSON credential.
# Never commit the actual JSON credential.
MARKETPLACE_MCP_ARCHIVE_GOOGLE_CREDENTIAL=

# Verified local archive cache used by the direct backend.
MARKETPLACE_MCP_ARCHIVE_CACHE_ROOT=


# --- Durable queue/staging + canonical backup on Yandex Object Storage ---
# Non-secret bucket name provisioned in the same Yandex Cloud TEST folder.
MARKETPLACE_MCP_ARCHIVE_BUCKET=
# Optional object-key prefix inside the dedicated bucket. Empty means bucket root.
MARKETPLACE_MCP_ARCHIVE_PREFIX=
# Optional endpoint override; normally leave empty and use storage.yandexcloud.net.
MARKETPLACE_MCP_ARCHIVE_ENDPOINT=
# Authentication is NOT configured here: Serverless Container obtains a temporary
# IAM token from its own Yandex service-account metadata endpoint.

# --- Durable canonical ORDERS history (YDB) ---
MARKETPLACE_MCP_YDB_ENDPOINT=

# --- Local / backwards-compatible credentials ---
WB_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# --- Canonical marketplace archive on REMOTE ---
# Google Drive is the canonical business archive.  These values must be present
# in the mcp-marketplaces service environment after migration from Yandex.
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_PROTOCOL=v3
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_URL=
MARKETPLACE_MCP_GOOGLE_DRIVE_BRIDGE_SECRET=
MARKETPLACE_MCP_ARCHIVE_DRIVE_ROOT_ID=

# Queue/staging/backup is a separate durable-backend concern.  Historical
# read-only queries remain available from Drive when this backend is absent;
# mutations fail closed until an explicit REMOTE backend is configured.

# --- Shared request-rate controller / active-cabinet state ---
# Canonical REMOTE uses local Redis on loopback. Do not expose Redis publicly.
# A full URL may be used instead, but all MCP processes must share one backend.
MARKETPLACE_MCP_REDIS_URL=redis://127.0.0.1:6379/0
MARKETPLACE_MCP_REDIS_HOST=
MARKETPLACE_MCP_REDIS_PORT=6379
MARKETPLACE_MCP_REDIS_PASSWORD=
MARKETPLACE_MCP_REDIS_DB=0
MARKETPLACE_MCP_REDIS_TLS=0
MARKETPLACE_MCP_REDIS_CA_CERT=

# Production REMOTE must fail closed when shared Redis is unavailable.
MARKETPLACE_REQUIRE_REDIS=1

# WB is seller + method/group scoped. Legacy WB_GLOBAL_RPS is ignored by code.
# Ozon Seller API aggregate quota: 50 RPS per Client-Id.
OZON_GLOBAL_RPS=50
OZON_PERF_GLOBAL_RPS=10

# Local single-host fallback only.
MARKETPLACE_RATE_LIMIT_DB=
