# Copy to .env and fill in. Never commit real keys.

# --- Remote MCP authentication ---
# Required by `python -m core.remote`. Inject the real value from Yandex Lockbox.
MARKETPLACE_MCP_BEARER_TOKEN=

# --- Wildberries (one token, scoped per category at seller.wildberries.ru) ---
WB_API_TOKEN=

# --- Ozon (Seller account -> Settings -> API keys) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- Shared request-rate controller ---
# Production / multiple processes or replicas: one shared Redis/Valkey is required.
# Store the real URL in Yandex Cloud Lockbox / deployment secrets, never in Git.
MARKETPLACE_MCP_REDIS_URL=

# Set to 1 on every production replica: missing Redis then stops marketplace calls.
MARKETPLACE_REQUIRE_REDIS=0

# Conservative global guard rails. Endpoint-specific limits from endpoints.yaml
# are applied in addition to these values. Do not set above marketplace limits.
WB_GLOBAL_RPS=5
OZON_GLOBAL_RPS=20
OZON_PERF_GLOBAL_RPS=10

# Single-host fallback for local development only.
MARKETPLACE_RATE_LIMIT_DB=
